[{"data":1,"prerenderedAt":832},["ShallowReactive",2],{"\u002Finterviews\u002Fjavascript\u002Fdoc\u002Foct-js-questions":3},{"id":4,"title":5,"body":6,"description":36,"extension":826,"meta":827,"navigation":324,"path":828,"seo":829,"stem":830,"__hash__":831},"content\u002Finterviews\u002Fjavascript\u002Fdoc\u002Foct-js-questions.md","October 2026 Javascript Questions",{"type":7,"value":8,"toc":816},"minimark",[9,14,18,21,30,53,60,70,84,89,95,100,127,133,141,152,160,163,179,182,196,200,214,262,266,269,376,380,400,465,540,548,552,555,561,644,651,660,666,677,681,687,691,759,763,766,770,776,783,789,793,796,802,806,812],[10,11,13],"h3",{"id":12},"what-is-hoisting","What is Hoisting",[15,16,17],"p",{},"Hoisting in Javascript is a mechanism where Javascript processes declarations before executing the code, making certain variables and functions available earlier in their scope.",[15,19,20],{},"In simple terms JavaScript prepare declarations before executing statements",[22,23,25,26],"h4",{"id":24},"hoisting-with-var","Hoisting with ",[27,28,29],"code",{},"var",[31,32,37],"pre",{"className":33,"code":34,"language":35,"meta":36,"style":36},"language-aiignore shiki shiki-themes github-light github-dark","    console.log(name)\n    var name = 'John'\n","aiignore","",[27,38,39,47],{"__ignoreMap":36},[40,41,44],"span",{"class":42,"line":43},"line",1,[40,45,46],{},"    console.log(name)\n",[40,48,50],{"class":42,"line":49},2,[40,51,52],{},"    var name = 'John'\n",[15,54,55,56,59],{},"Answer:  ",[27,57,58],{},"name"," is undefined",[22,61,25,63,66,67],{"id":62},"hoisting-with-let-and-const",[27,64,65],{},"let"," and ",[27,68,69],{},"const",[31,71,73],{"className":33,"code":72,"language":35,"meta":36,"style":36},"    console.log(name)\n    let name = 'John'\n",[27,74,75,79],{"__ignoreMap":36},[40,76,77],{"class":42,"line":43},[40,78,46],{},[40,80,81],{"class":42,"line":49},[40,82,83],{},"    let name = 'John'\n",[15,85,55,86,88],{},[27,87,58],{}," is not ReferenceError",[22,90,25,92],{"id":91},"hoisting-with-functions",[27,93,94],{},"functions",[96,97,99],"h5",{"id":98},"unnamed-function","Unnamed function",[31,101,103],{"className":33,"code":102,"language":35,"meta":36,"style":36},"    helloName()\n    function helloName() {\n        console.log('Hello World')\n    }\n",[27,104,105,110,115,121],{"__ignoreMap":36},[40,106,107],{"class":42,"line":43},[40,108,109],{},"    helloName()\n",[40,111,112],{"class":42,"line":49},[40,113,114],{},"    function helloName() {\n",[40,116,118],{"class":42,"line":117},3,[40,119,120],{},"        console.log('Hello World')\n",[40,122,124],{"class":42,"line":123},4,[40,125,126],{},"    }\n",[15,128,55,129,132],{},[27,130,131],{},"helloName"," is executed and prints 'Hello World'",[96,134,136,137,66,139],{"id":135},"named-functions-let-and-var","Named functions ",[27,138,65],{},[27,140,29],{},[15,142,143,144,146,147,66,149,151],{},"Similarly to variable ",[27,145,29],{}," function return TypeError\u002FUndefined, but ",[27,148,65],{},[27,150,69],{}," return ReferenceError",[96,153,155,156,159],{"id":154},"how-javascript-handle-hoisting-internally","How ",[27,157,158],{},"JavaScript"," handle hoisting internally",[15,161,162],{},"Phase 1: Creation Phase",[164,165,166,170,173,176],"ul",{},[167,168,169],"li",{},"Creates the execution context",[167,171,172],{},"Registers variable and function declarations",[167,174,175],{},"Allocates memory for variables",[167,177,178],{},"Sets up lexical environments",[15,180,181],{},"Phase 2: Execution Phase",[164,183,184,187,190,193],{},[167,185,186],{},"Executes the code line by line",[167,188,189],{},"Assigns values",[167,191,192],{},"Calls functions",[167,194,195],{},"Evaluate expressions",[10,197,199],{"id":198},"constructor-in-javascript","Constructor in JavaScript",[15,201,202,203,206,207,210,211,213],{},"A constructor is a special function that creates and initializes an object instance of a class. In JavaScript, a constructor is defined using the ",[27,204,205],{},"new"," keyword and the ",[27,208,209],{},"this"," keyword. When a constructor is called, it creates a new object and sets the ",[27,212,209],{}," keyword to refer to that object. The constructor can then initialize the object's properties and methods.",[31,215,217],{"className":33,"code":216,"language":35,"meta":36,"style":36}," class User {\n    #name = '';\n    #age  = '';\n    constructor(name, age) {\n        this.#name = name;\n        this.#age = age;\n    }\n }\n",[27,218,219,224,229,234,239,245,251,256],{"__ignoreMap":36},[40,220,221],{"class":42,"line":43},[40,222,223],{}," class User {\n",[40,225,226],{"class":42,"line":49},[40,227,228],{},"    #name = '';\n",[40,230,231],{"class":42,"line":117},[40,232,233],{},"    #age  = '';\n",[40,235,236],{"class":42,"line":123},[40,237,238],{},"    constructor(name, age) {\n",[40,240,242],{"class":42,"line":241},5,[40,243,244],{},"        this.#name = name;\n",[40,246,248],{"class":42,"line":247},6,[40,249,250],{},"        this.#age = age;\n",[40,252,254],{"class":42,"line":253},7,[40,255,126],{},[40,257,259],{"class":42,"line":258},8,[40,260,261],{}," }\n",[10,263,265],{"id":264},"implements-vs-extend","Implements vs Extend",[15,267,268],{},"Extend used to inherit other classes",[31,270,272],{"className":33,"code":271,"language":35,"meta":36,"style":36},"class Animal{\n    name: string;\n    constructor(name: string){\n        this.name = name;\n    }\n    eat(){\n        console.log('Animal is eating')\n    }    \n}\n\nclass Dog extends Animal{\n    constructor(name, age){\n        super(name);\n        this.#age = age;\n    }\n    bark(){\n        console.log('Dog is barking')\n    }\n}\n\n",[27,273,274,279,284,289,294,298,303,308,313,319,326,332,338,344,349,354,360,366,371],{"__ignoreMap":36},[40,275,276],{"class":42,"line":43},[40,277,278],{},"class Animal{\n",[40,280,281],{"class":42,"line":49},[40,282,283],{},"    name: string;\n",[40,285,286],{"class":42,"line":117},[40,287,288],{},"    constructor(name: string){\n",[40,290,291],{"class":42,"line":123},[40,292,293],{},"        this.name = name;\n",[40,295,296],{"class":42,"line":241},[40,297,126],{},[40,299,300],{"class":42,"line":247},[40,301,302],{},"    eat(){\n",[40,304,305],{"class":42,"line":253},[40,306,307],{},"        console.log('Animal is eating')\n",[40,309,310],{"class":42,"line":258},[40,311,312],{},"    }    \n",[40,314,316],{"class":42,"line":315},9,[40,317,318],{},"}\n",[40,320,322],{"class":42,"line":321},10,[40,323,325],{"emptyLinePlaceholder":324},true,"\n",[40,327,329],{"class":42,"line":328},11,[40,330,331],{},"class Dog extends Animal{\n",[40,333,335],{"class":42,"line":334},12,[40,336,337],{},"    constructor(name, age){\n",[40,339,341],{"class":42,"line":340},13,[40,342,343],{},"        super(name);\n",[40,345,347],{"class":42,"line":346},14,[40,348,250],{},[40,350,352],{"class":42,"line":351},15,[40,353,126],{},[40,355,357],{"class":42,"line":356},16,[40,358,359],{},"    bark(){\n",[40,361,363],{"class":42,"line":362},17,[40,364,365],{},"        console.log('Dog is barking')\n",[40,367,369],{"class":42,"line":368},18,[40,370,126],{},[40,372,374],{"class":42,"line":373},19,[40,375,318],{},[10,377,379],{"id":378},"microtask-vs-macrotask","MicroTask vs MacroTask",[15,381,382,66,385,388,389,392,393,396,397,399],{},[27,383,384],{},"MicroTask",[27,386,387],{},"MacroTask"," are two categories of asynchronous tasks handled by the ",[27,390,391],{},"Event Loop",". The key difference is their execution priority. ",[27,394,395],{},"MicroTasks"," run before then next ",[27,398,387],{},".",[401,402,403,417],"table",{},[404,405,406],"thead",{},[407,408,409,413,415],"tr",{},[410,411,412],"th",{},"Features",[410,414,384],{},[410,416,387],{},[418,419,420,432,443,454],"tbody",{},[407,421,422,426,429],{},[423,424,425],"td",{},"Priority",[423,427,428],{},"High",[423,430,431],{},"Low",[407,433,434,437,440],{},[423,435,436],{},"Examples",[423,438,439],{},"Promises, async\u002Fawait, queueMicrotask()",[423,441,442],{},"setTimeout, setInterval, I\u002FO operations",[407,444,445,448,451],{},[423,446,447],{},"Execution Order",[423,449,450],{},"Runs before the next MacroTask",[423,452,453],{},"Runs after all MicroTasks",[407,455,456,459,462],{},[423,457,458],{},"Procesing",[423,460,461],{},"All queued microtasks are processed before the next MacroTask",[423,463,464],{},"One task is processed per event-loop iteration",[31,466,468],{"className":33,"code":467,"language":35,"meta":36,"style":36},"console.log(\"1. Start\");\n\nsetTimeout(() => {\n  console.log(\"2. setTimeout\");\n}, 0);\n\nPromise.resolve().then(() => {\n  console.log(\"3. Promise\");\n});\n\nqueueMicrotask(() => {\n  console.log(\"4. queueMicrotask\");\n});\n\nconsole.log(\"5. End\");\n",[27,469,470,475,479,484,489,494,498,503,508,513,517,522,527,531,535],{"__ignoreMap":36},[40,471,472],{"class":42,"line":43},[40,473,474],{},"console.log(\"1. Start\");\n",[40,476,477],{"class":42,"line":49},[40,478,325],{"emptyLinePlaceholder":324},[40,480,481],{"class":42,"line":117},[40,482,483],{},"setTimeout(() => {\n",[40,485,486],{"class":42,"line":123},[40,487,488],{},"  console.log(\"2. setTimeout\");\n",[40,490,491],{"class":42,"line":241},[40,492,493],{},"}, 0);\n",[40,495,496],{"class":42,"line":247},[40,497,325],{"emptyLinePlaceholder":324},[40,499,500],{"class":42,"line":253},[40,501,502],{},"Promise.resolve().then(() => {\n",[40,504,505],{"class":42,"line":258},[40,506,507],{},"  console.log(\"3. Promise\");\n",[40,509,510],{"class":42,"line":315},[40,511,512],{},"});\n",[40,514,515],{"class":42,"line":321},[40,516,325],{"emptyLinePlaceholder":324},[40,518,519],{"class":42,"line":328},[40,520,521],{},"queueMicrotask(() => {\n",[40,523,524],{"class":42,"line":334},[40,525,526],{},"  console.log(\"4. queueMicrotask\");\n",[40,528,529],{"class":42,"line":340},[40,530,512],{},[40,532,533],{"class":42,"line":346},[40,534,325],{"emptyLinePlaceholder":324},[40,536,537],{"class":42,"line":351},[40,538,539],{},"console.log(\"5. End\");\n",[31,541,546],{"className":542,"code":544,"language":545},[543],"language-text","1. Start\n5. End\n3. Promise\n4. queueMicrotask\n2. setTimeout\n","text",[27,547,544],{"__ignoreMap":36},[10,549,551],{"id":550},"what-is-event-emitter","What is Event Emitter",[15,553,554],{},"And Event Emitter is design pattern and mechanism that allows one part of the application to  emit ( publish) events and other parts of the application to subscribe to those events and react to them.",[31,556,559],{"className":557,"code":558,"language":545},[543],"const EventEmitter = require('events');\nconst emitter = new EventEmitter();\n\n\u002F\u002F Subscribe to an event\nemitter.on('userRegistered', (user) => {\n  console.log('Welcome:', user.name);\n});\n\n\u002F\u002F Emit an event\nemitter.emit('userRegistered', {\n  id: 1,\n  name: 'Sibin'\n});\n",[27,560,558],{"__ignoreMap":36},[401,562,563,573],{},[404,564,565],{},[407,566,567,570],{},[410,568,569],{},"Method",[410,571,572],{},"Purpose",[418,574,575,585,595,605,615,624,634],{},[407,576,577,582],{},[423,578,579],{},[27,580,581],{},"on",[423,583,584],{},"Register an event listener",[407,586,587,592],{},[423,588,589],{},[27,590,591],{},"emit",[423,593,594],{},"Trigger an event",[407,596,597,602],{},[423,598,599],{},[27,600,601],{},"once",[423,603,604],{},"Execute an event listener only once",[407,606,607,612],{},[423,608,609],{},[27,610,611],{},"off",[423,613,614],{},"Remove an event listener",[407,616,617,622],{},[423,618,619],{},[27,620,621],{},"removeListener",[423,623,614],{},[407,625,626,631],{},[423,627,628],{},[27,629,630],{},"removeAllListeners",[423,632,633],{},"Remove all event listeners",[407,635,636,641],{},[423,637,638],{},[27,639,640],{},"listenerCount",[423,642,643],{},"Get the number of listeners for an event",[10,645,647,648],{"id":646},"what-is-a-promise","What is a ",[27,649,650],{},"Promise",[15,652,653,654,656,657,659],{},"A ",[27,655,650],{}," is a ",[27,658,158],{}," object that represents the eventual completion or failure of an asynchronus operation.",[22,661,663,664],{"id":662},"stages-of-promise","Stages of ",[27,665,650],{},[164,667,668,671,674],{},[167,669,670],{},"Pending: Operation is still running",[167,672,673],{},"Fulfilled: Operation completed successfully",[167,675,676],{},"Rejected: Operation failed",[22,678,680],{"id":679},"promise-example","Promise Example",[31,682,685],{"className":683,"code":684,"language":545},[543],"const myPromise = new Promise((resolve, reject) => {\n    \u002F\u002F Run some operation, async - await, setTimeout \n    const success = true; \u002F\u002F some api etc..\n    if(success){\n        resolve(\u002F\u002Fdata)\n    }else{\n        reject(\u002F\u002Freason)\n    }\n});\n\nmyPromise.then((response) => {\n    \u002F\u002F Success\n}).catch((error) => {\n    \u002F\u002F Error\n}).finally(() => {\n    \u002F\u002F After complete all\n})\n\n",[27,686,684],{"__ignoreMap":36},[22,688,690],{"id":689},"promise-methods","Promise methods",[401,692,693,705],{},[404,694,695],{},[407,696,697,699,702],{},[410,698,569],{},[410,700,701],{},"Behavior",[410,703,704],{},"When to Use",[418,706,707,720,733,746],{},[407,708,709,714,717],{},[423,710,711],{},[27,712,713],{},"Promise.all",[423,715,716],{},"Resolve when all promises succeeded. Reject immediately if any promise fail",[423,718,719],{},"When all independent tasks must complete successfully",[407,721,722,727,730],{},[423,723,724],{},[27,725,726],{},"Promise.allSettled",[423,728,729],{},"Waits for all promises to suites and return array of status object",[423,731,732],{},"When you need the outcome of every request regardless of individual failures",[407,734,735,740,743],{},[423,736,737],{},[27,738,739],{},"Promise.race",[423,741,742],{},"Settles as soon as the first Promise settles (success\u002Ffailure)",[423,744,745],{},"Setting timeouts on requests or handling fastest response scenarios",[407,747,748,753,756],{},[423,749,750],{},[27,751,752],{},"Promise.any",[423,754,755],{},"Resolve as soon as first Promise fullfill, ignore rejections unless all failes",[423,757,758],{},"Finding first successful response",[10,760,762],{"id":761},"how-do-you-handle-errors-in-synchronous-and-asynchronouse-operations","How do you handle errors in Synchronous and Asynchronouse operations",[15,764,765],{},"Error handling in JavaScript differ between asynchronous and synchronus. Synchronous operation block execution and throw error immediately while asynchronous operations\ndeals with results and rejections occure later without blocking, non blocking time.",[96,767,769],{"id":768},"synchronus-operation","Synchronus operation",[31,771,774],{"className":772,"code":773,"language":545},[543],"    try{\n        const a = JSON.parse(\u003CSTRING DATA>)\n    }catch(e){\n        console.log('Error', e)\n    }\n",[27,775,773],{"__ignoreMap":36},[22,777,779,780],{"id":778},"asynchromous-with-async-await","Asynchromous with ",[27,781,782],{},"async - await",[31,784,787],{"className":785,"code":786,"language":545},[543],"try{\n    const response = await fetch(')\n}catch(e){\n    console.log('Error ', e)\n}\n",[27,788,786],{"__ignoreMap":36},[22,790,792],{"id":791},"promise-catch","Promise .catch",[15,794,795],{},"Promise has catch block where error handled",[31,797,800],{"className":798,"code":799,"language":545},[543],"aPromise.then(() => {\n\n}).catch((error) => {\n    console.log(error)\n})\n\n",[27,801,799],{"__ignoreMap":36},[22,803,805],{"id":804},"node-global-error","Node global error",[31,807,810],{"className":808,"code":809,"language":545},[543],"    process.on('unhandledRejection', (reason, promise) => {\n    console.error('Unhandled Rejection at:', promise, 'reason:', reason);\n    \u002F\u002F Perform cleanup and gracefully shut down if necessary\n    });\n\n    \u002F\u002F Catches truly uncaught synchronous exceptions\n    process.on('uncaughtException', (error) => {\n    console.error('Uncaught Exception thrown:', error);\n    process.exit(1);\n    });\n",[27,811,809],{"__ignoreMap":36},[813,814,815],"style",{},"html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":36,"searchDepth":49,"depth":49,"links":817},[818,819,820,821,822,823,825],{"id":12,"depth":117,"text":13},{"id":198,"depth":117,"text":199},{"id":264,"depth":117,"text":265},{"id":378,"depth":117,"text":379},{"id":550,"depth":117,"text":551},{"id":646,"depth":117,"text":824},"What is a Promise",{"id":761,"depth":117,"text":762},"md",{},"\u002Finterviews\u002Fjavascript\u002Fdoc\u002Foct-js-questions",{"title":5,"description":36},"interviews\u002Fjavascript\u002Fdoc\u002Foct-js-questions","iibUVedL3V1m3fBXPuBcLADxjIVvAboP5uZVt5B3Mjo",1793614439691]