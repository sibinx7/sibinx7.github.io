artmentID = d.Departmentid\n","text",[19,632,629],{"__ignoreMap":633},"",[603,635,637],{"id":636},"subquery","SubQuery",[15,639,640],{},"A SubQuery is a query nested inside another SQL statement (such as inside a SELECT, FROM, WHERE or HAVING clause)",[50,642,643,649],{},[53,644,645,648],{},[19,646,647],{},"Uncorrelated Subquery",": Independent of the outer query. It run once, and its result is handled to the outer query. It runs once, and its result is handed to the outer query",[53,650,651,654],{},[19,652,653],{},"Correlated SubQuery",": Depends on the outer query. It re-runs for every single roww processed by the outer query.",[625,656,659],{"className":657,"code":658,"language":630},[628],"SELECT EmployeeName, Salary FROM EMPLOYEE WHERE\nSalary > (\n  SELECT AVG(SALARY) FROM Employees\n)\n",[19,660,658],{"__ignoreMap":633},{"title":633,"searchDepth":662,"depth":662,"links":663},2,[664,666],{"id":12,"depth":665,"text":13},3,{"id":600,"depth":665,"text":601},"md",{},true,"\u002Finterviews\u002Fdatabase\u002Fdoc",{"title":5,"description":633},"interviews\u002Fdatabase\u002Fdoc\u002Findex","2R3cDRn7TYguqB6UxFhq0ZzUUupuU2cN6XWNFxs8wnM",1794040913033]